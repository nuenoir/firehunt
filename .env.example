# Copy to .env.local and fill in what you have. .env.local is git-ignored.
# Everything is optional: features whose keys are missing simply switch off.

# --- Job search -------------------------------------------------------------
# Adzuna (Australia, Singapore, Europe): https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble (Gulf): https://jooble.org/api/about
JOOBLE_API_KEY=

# --- Cloud sync (Supabase) --------------------------------------------------
# Public by design: protected by row-level security, not by secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# The Supabase user id of the account owner (gets the WhatsApp features).
OWNER_USER_ID=

# --- WhatsApp notifications (CallMeBot) -------------------------------------
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# A long random string; Vercel Cron sends it to the daily digest endpoint.
CRON_SECRET=

# --- AI features (Anthropic) ------------------------------------------------
# From console.anthropic.com. Pay-as-you-go; set a monthly spend limit there.
ANTHROPIC_API_KEY=
# Optional overrides (defaults shown):
# AI_MODEL_ANALYZE=claude-opus-5-5
# AI_MODEL_EXTRACT=claude-opus-5-5
# AI_DAILY_LIMIT_PER_USER=15
# AI_DAILY_LIMIT_GLOBAL=150
